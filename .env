SSL_CERT_FILE=/ssl/server.crt
SSL_KEY_FILE=/ssl/server.key
SERVICE_PORT=9000
# Version of wseresearch/microservice-updater to run. Pin it in production:
# a floating 'latest' on the component that deploys everything else means an
# unrelated push can change what is running. Rollback = edit this + up -d.
MSU_VERSION=latest
