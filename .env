SSL_CERT_FILE=/ssl/server.crt
SSL_KEY_FILE=/ssl/server.key
SERVICE_PORT=9000\n# Version of wseresearch/microservice-updater to run. Pin it in production:\n# a floating 'latest' on the component that deploys everything else means an\n# unrelated push can change what is running. Rollback = edit this + up -d.\nMSU_VERSION=latest\n